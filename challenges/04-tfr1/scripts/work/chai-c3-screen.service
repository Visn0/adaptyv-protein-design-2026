[Unit]
Description=chai restrained screen, campaign-3 switch variants (c3-screen-list.txt)
[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=30
WorkingDirectory=%h/c4-work/chai
ExecStart=/bin/bash %h/c4-work/bin/chai-screen-batch.sh %h/c4-work/chai/c3-screen-list.txt
StandardOutput=append:%h/c4-work/logs/c3-screen.log
StandardError=append:%h/c4-work/logs/c3-screen.log
[Install]
WantedBy=default.target
