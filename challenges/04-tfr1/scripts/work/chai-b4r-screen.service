[Unit]
Description=chai restrained screen, batch-4R RFdiffusion arm (b4r-screen-list.txt)
[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=30
WorkingDirectory=%h/c4-work/chai
ExecStart=/bin/bash %h/c4-work/bin/chai-screen-batch.sh %h/c4-work/chai/b4r-screen-list.txt
StandardOutput=append:%h/c4-work/logs/b4r-screen.log
StandardError=append:%h/c4-work/logs/b4r-screen.log
[Install]
WantedBy=default.target
