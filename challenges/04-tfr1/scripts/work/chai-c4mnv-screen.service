[Unit]
Description=chai restrained screen, campaign-4 mouse cross-fold, C3 survivors (c4v-screen-list.txt)
[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=30
WorkingDirectory=%h/c4-work/chai
ExecStart=/bin/bash %h/c4-work/bin/chai-screen-batch.sh %h/c4-work/chai/c4v-screen-list.txt
StandardOutput=append:%h/c4-work/logs/c4v-screen.log
StandardError=append:%h/c4-work/logs/c4v-screen.log
[Install]
WantedBy=default.target
