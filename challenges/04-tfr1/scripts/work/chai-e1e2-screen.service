[Unit]
Description=chai restrained screen, E1/E2 hygiene pass (e1e2-screen-list.txt)
[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=30
WorkingDirectory=%h/c4-work/chai
ExecStart=/bin/bash %h/c4-work/bin/chai-screen-batch.sh %h/c4-work/chai/e1e2-screen-list.txt
StandardOutput=append:%h/c4-work/logs/e1e2-screen.log
StandardError=append:%h/c4-work/logs/e1e2-screen.log
[Install]
WantedBy=default.target
