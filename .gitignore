.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.DS_Store
.env
.claude/

# Experiment outputs and heavy per-challenge data. The CONTENTS are ignored,
# not the dirs, so the small evidence files below can be re-included while the
# raw data stays out. `make fetch-data` copies the public target files back.
challenges/**/runs/*
challenges/**/data/*
challenges/.locks/
!challenges/02-tnfa/data/epitope-analysis/
*.pka
runs-dashboard.html

# Fetched/generated per-challenge heavy inputs (controls fetched by runs,
# backbones + folded complexes dropped in from external GPU steps)
challenges/*/inputs/controls/
challenges/*/inputs/backbones/
challenges/*/inputs/complexes/

# Handoff package: heavy binary payloads stay out of git (the text parts commit).
# Rebuild the package with: python challenges/02-tnfa/handoff/scripts/prepare_handoff.py
challenges/02-tnfa/handoff/data-raw/
challenges/02-tnfa/handoff/c2-handoff.tar.gz


# Video series: render and TTS intermediates stay out; out/ (mp4 + srt) commits.
challenges/02-tnfa/videos/media/
challenges/03-glp1r/videos/media/
challenges/03-glp1r/videos/media_draft/
challenges/03-glp1r/videos/audio/
challenges/03-glp1r/videos/qa/frames/
challenges/02-tnfa/videos/media_draft/
challenges/02-tnfa/videos/audio/
challenges/02-tnfa/videos/qa/frames/

# Mol* viewpoint renders: the PNGs + manifest.json are the evidence; the page,
# its bundle copy and the explorer copy are regenerated by the tool.
challenges/02-tnfa/viewers/views/*/molstar-bundle.js
challenges/02-tnfa/viewers/views/*/*_page.html
challenges/02-tnfa/viewers/views/*/*_explorer.html

# The built site and the deploy tool install: never committed.
site/dist/
site/node_modules/
# The recorder's scratch dir: raw .webm takes live here until they are converted.
site/demo/.recordings/
site/.wrangler/

# Demo recorder's node dependencies (site/scripts/package.json pins them).
node_modules/
